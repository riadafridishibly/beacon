package web

// Document is the HTML shell every layout renders into.
templ Document(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>{ title } · { BrandName(ctx) }</title>
			<link rel="icon" type="image/svg+xml" href={ templ.SafeURL(brandFaviconPath) }/>
			@AssetTags()
		</head>
		<body class="min-h-screen bg-base-200 text-base-content antialiased">
			{ children... }
		</body>
	</html>
}

// Nav is what the header shows for the signed-in account; nil shows only
// the brand.
type Nav struct {
	Email      string
	LogoutPath string
}

// Layout is the page frame: a header, the htmx error banner, the main column
// and a footer. The footer link is the attribution DB-IP's licence requires
// on pages that show its data.
templ Layout(title string, nav *Nav) {
	@Document(title) {
		<header class="border-b border-base-300 bg-base-100">
			<nav class="navbar mx-auto max-w-6xl gap-4 px-4">
				<a href="/" class="flex min-w-0 flex-1 items-center gap-2 text-lg font-semibold tracking-tight">
					<img src={ brandLogoPath } alt="" width="24" height="24" class="size-6 shrink-0"/>
					<span class="truncate">{ BrandName(ctx) }</span>
				</a>
				if nav != nil {
					<span class="text-sm opacity-70 max-sm:hidden">{ nav.Email }</span>
					<form method="post" action={ templ.SafeURL(nav.LogoutPath) }>
						<button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
					</form>
				}
			</nav>
		</header>
		<div id="request-error" role="alert" hidden class="mx-auto mt-4 w-full max-w-6xl px-4">
			<p class="alert alert-error alert-soft">Something went wrong. Please try again.</p>
		</div>
		<main class="mx-auto max-w-6xl px-4 py-8">
			{ children... }
		</main>
		<footer class="mx-auto max-w-6xl px-4 pb-8 text-xs opacity-60">
			<a href="https://db-ip.com" class="link link-hover">IP Geolocation by DB-IP</a>
		</footer>
	}
}

// PageHeader is a page title with its actions.
templ PageHeader(title string) {
	<div class="mb-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
		<h1 class="min-w-0 text-2xl font-semibold tracking-tight wrap-break-word">{ title }</h1>
		<div class="flex flex-wrap items-center gap-2">
			{ children... }
		</div>
	</div>
}

// NotFoundPage is the 404 page.
templ NotFoundPage() {
	@Layout("Not found", nil) {
		@PageHeader("Page not found")
		<a href="/" class={ LinkClass }>Go to the apps</a>
	}
}

// TimeoutPage is shown when a request runs out of time.
templ TimeoutPage() {
	@Layout("Timed out", nil) {
		@PageHeader("This page took too long")
		<p class="opacity-70">Try again, or go back to the <a href="/" class={ LinkClass }>apps</a>. On a page with a time range, a shorter range loads faster.</p>
	}
}

// ErrorPage is the 500 page.
templ ErrorPage() {
	@Layout("Error", nil) {
		@PageHeader("Something went wrong")
		<p class="opacity-70">The error has been logged. Try again, or go back to the <a href="/" class={ LinkClass }>apps</a>.</p>
	}
}
