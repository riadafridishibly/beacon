package dashboard

import (
	"strconv"
	"strings"
	"time"

	"github.com/riadafridishibly/beacon/internal/web"
)

const subjectColumns = "grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-0.5 px-4 sm:grid-cols-[minmax(0,1fr)_5.5rem_6rem_4rem_3.5rem]"

// timelineColumns is shared by every row so columns line up across days.
const timelineColumns = "grid grid-cols-[4.5rem_minmax(0,1fr)_auto] gap-x-3 px-4 sm:grid-cols-[4.5rem_minmax(0,1fr)_minmax(0,11rem)_4.5rem_1rem]"

func utcTime(t time.Time) string { return t.UTC().Format(time.DateTime) + " UTC" }

templ subjectsPage(nav *web.Nav, v subjectsView) {
	@web.Layout(v.Kind.title()+" · "+v.App.Name, nav) {
		@appHeader(v.App, v.Kind.tab())
		<div id="subjects" class="transition-opacity [&.htmx-request]:opacity-60">
			@subjectsBody(v)
		</div>
	}
}

// subjectsBody is the part a page change replaces.
templ subjectsBody(v subjectsView) {
	if len(v.Rows) == 0 {
		<div class={ web.PaddedCardClass, "text-center" }>
			if v.Before == "" {
				<p class="opacity-70">No { v.Kind.tab() } yet.</p>
			} else {
				<p class="opacity-70">No older { v.Kind.tab() }.</p>
			}
		</div>
	} else {
		<div class={ web.CardClass, "overflow-hidden" }>
			<div aria-hidden="true" class={ subjectColumns, "border-b border-base-300 py-2 text-xs opacity-60 max-sm:hidden" }>
				<span>{ strings.ToUpper(v.Kind.noun()[:1]) + v.Kind.noun()[1:] }</span>
				<span>Last seen</span>
				<span>Version</span>
				<span>Country</span>
				<span class="text-right">Errors</span>
			</div>
			<ul class="divide-y divide-base-300">
				for _, r := range v.Rows {
					<li>
						<a href={ templ.SafeURL(subjectURL(v.App.ID, v.Kind, r.ID, "")) } class={ subjectColumns, "py-2.5 text-sm hover:bg-base-200" }>
							<span class="truncate font-mono text-xs leading-5" title={ r.ID }>{ r.ID }</span>
							<time class="text-xs leading-5 whitespace-nowrap opacity-70" title={ utcTime(r.LastSeen) }>{ ago(r.LastSeen, v.Now) }</time>
							<span class="flex gap-3 text-xs leading-5 opacity-70 max-sm:col-span-2 sm:contents sm:text-sm">
								<span class="truncate" title={ deref(r.AppVersion) }>{ deref(r.AppVersion) }</span>
								<span>{ deref(r.Country) }</span>
								<span class={ "tabular-nums sm:text-right", templ.KV("text-error", r.Errors > 0) }>
									{ web.Count(r.Errors) }
									<span class="sm:hidden">
										if r.Errors == 1 {
											error
										} else {
											errors
										}
									</span>
								</span>
							</span>
						</a>
					</li>
				}
			</ul>
		</div>
	}
	if v.Before != "" || v.Older != "" {
		<nav aria-label="Pages" hx-boost="true" hx-target="#subjects" hx-indicator="#subjects" class="mt-4 flex justify-end gap-2">
			if v.Before != "" {
				<a href={ templ.SafeURL(subjectsURL(v.App.ID, v.Kind, "")) } class="btn btn-sm">Newest</a>
			}
			if v.Older != "" {
				<a href={ templ.SafeURL(v.Older) } class="btn btn-sm">Older</a>
			}
		</nav>
	}
}

templ subjectPage(nav *web.Nav, v subjectView) {
	@web.Layout(v.ID+" · "+v.App.Name, nav) {
		@appHeader(v.App, v.Kind.tab())
		<p class="text-sm opacity-70">
			<a href={ templ.SafeURL(subjectsURL(v.App.ID, v.Kind, "")) } class="link-hover">{ v.Kind.title() }</a>
		</p>
		<h2 class="mb-4 font-mono text-lg wrap-anywhere">{ v.ID }</h2>
		<dl class={ web.PaddedCardClass, "mb-4 grid grid-cols-2 gap-x-6 gap-y-3 lg:grid-cols-4" }>
			@fact("Last seen", ago(v.Summary.LastSeen, v.Now), utcTime(v.Summary.LastSeen))
			@fact("First seen", ago(v.Summary.FirstSeen, v.Now), utcTime(v.Summary.FirstSeen))
			@fact("Events", web.Count(v.Summary.Events), "")
			@fact("Errors", web.Count(v.Summary.Errors), "")
			@fact("App version", deref(v.Summary.AppVersion), "")
			@fact("Platform", v.platform(), "")
			@fact("Location", v.location(), "")
		</dl>
		if len(v.Related) > 0 {
			<section class="mb-6">
				<h3 class="mb-2 text-sm font-medium">{ v.relatedHeading() }</h3>
				<ul class="flex flex-wrap gap-2">
					for _, r := range v.Related {
						<li class="max-w-full">
							<a
								href={ templ.SafeURL(subjectURL(v.App.ID, v.Kind.other(), r.ID, "")) }
								title={ "Last seen " + ago(r.LastSeen, v.Now) }
								class="badge badge-outline max-w-full truncate font-mono text-xs hover:bg-base-200"
							>{ r.ID }</a>
						</li>
					}
				</ul>
				if v.More {
					<p class="mt-2 text-xs opacity-60">Showing the { strconv.Itoa(relatedLimit) } most recent.</p>
				}
			</section>
		}
		<div class="mb-2 flex items-baseline justify-between gap-4">
			<h3 class="text-sm font-medium">Timeline <span class="font-normal opacity-60">(UTC)</span></h3>
			<a href={ templ.SafeURL(eventsURL(v.App.ID, v.Kind.filter(v.ID), "")) } class="link link-primary link-hover text-sm">Filter in Events</a>
		</div>
		<div id="timeline" class="transition-opacity [&.htmx-request]:opacity-60">
			@timeline(v)
		</div>
	}
}

func (v subjectView) relatedHeading() string {
	if v.Kind == userSubject {
		return "Devices of this user"
	}
	return "Users on this device"
}

templ fact(label, value, title string) {
	<div class="min-w-0">
		<dt class="text-xs opacity-60">{ label }</dt>
		<dd class="text-sm wrap-break-word" title={ title }>
			if value == "" {
				<span class="opacity-50">Unknown</span>
			} else {
				{ value }
			}
		</dd>
	</div>
}

// timeline is the part a page change replaces.
templ timeline(v subjectView) {
	if len(v.Days) == 0 {
		<div class={ web.PaddedCardClass, "text-center" }>
			<p class="opacity-70">No older events.</p>
		</div>
	} else {
		<div class={ web.CardClass, "overflow-hidden" }>
			for _, day := range v.Days {
				<section>
					<h4 class="border-b border-base-300 bg-base-200/50 px-4 py-1.5 text-xs font-medium">{ day.Label }</h4>
					<ul class="divide-y divide-base-300 border-b border-base-300">
						for _, r := range day.Rows {
							<li>
								@timelineEntry(r)
							</li>
						}
					</ul>
				</section>
			}
		</div>
	}
	if v.Before != "" || v.Older != "" {
		<nav aria-label="Timeline pages" hx-boost="true" hx-target="#timeline" hx-indicator="#timeline" class="mt-4 flex justify-end gap-2">
			if v.Before != "" {
				<a href={ templ.SafeURL(subjectURL(v.App.ID, v.Kind, v.ID, "")) } class="btn btn-sm">Newest</a>
			}
			if v.Older != "" {
				<a href={ templ.SafeURL(v.Older) } class="btn btn-sm">Older</a>
			}
		</nav>
	}
}

templ timelineEntry(r timelineRow) {
	<details class="group">
		<summary class={ timelineColumns, "cursor-pointer list-none py-2.5 text-sm hover:bg-base-200 [&::-webkit-details-marker]:hidden" }>
			<time class="text-xs leading-5 tabular-nums opacity-70">{ r.Clock }</time>
			<span class={ "truncate font-mono text-xs leading-5", templ.KV("text-error", strings.HasPrefix(r.Event.Name, "error.")) } title={ r.Event.Name }>{ r.Event.Name }</span>
			<span class="truncate font-mono text-xs leading-5 opacity-70 max-sm:hidden" title={ r.Other }>{ r.Other }</span>
			<span class="truncate text-xs leading-5 opacity-70 sm:text-sm" title={ r.Event.Version }>{ r.Event.Version }</span>
			<svg class="mt-1 size-3 opacity-50 transition-transform group-open:rotate-90 max-sm:hidden" viewBox="0 0 12 12" fill="none" aria-hidden="true">
				<path d="M4.5 2.5 8 6 4.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</summary>
		@eventDetails(r.Event)
	</details>
}
