package dashboard

import (
	"strings"

	"github.com/riadafridishibly/beacon/internal/web"
)

// eventColumns is shared by the header and each row so their columns line up.
const eventColumns = "grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-0.5 px-4 sm:grid-cols-[9.5rem_minmax(0,1fr)_minmax(0,9rem)_minmax(0,9rem)_3.5rem_4.5rem_1rem]"

templ eventsPage(nav *web.Nav, v eventsView) {
	@web.Layout("Events · "+v.App.Name, nav) {
		@appHeader(v.App, "events")
		<div
			id="events"
			hx-boost="true"
			hx-target="this"
			hx-indicator="this"
			class="transition-opacity [&.htmx-request]:opacity-60"
		>
			@eventsBody(v)
		</div>
	}
}

// eventsBody is the part a filter or page change replaces.
templ eventsBody(v eventsView) {
	<form
		method="get"
		action={ templ.SafeURL(eventsURL(v.App.ID, eventFilter{}, "")) }
		class="mb-4 grid grid-cols-2 items-end gap-3 lg:grid-cols-[repeat(5,minmax(0,1fr))_auto]"
	>
		@filterInput("Event", "name", v.Filter.Name)
		@filterInput("Device", "device", v.Filter.Device)
		@filterInput("User", "user", v.Filter.User)
		@filterInput("Country", "country", v.Filter.Country)
		@filterInput("App version", "version", v.Filter.Version)
		<div class="flex gap-2">
			<button type="submit" class="btn btn-primary btn-sm">Filter</button>
			if v.Filter != (eventFilter{}) {
				<a href={ templ.SafeURL(eventsURL(v.App.ID, eventFilter{}, "")) } class="btn btn-ghost btn-sm">Clear</a>
			}
		</div>
	</form>
	if len(v.Rows) == 0 {
		<div class={ web.PaddedCardClass, "text-center" }>
			if v.Filter == (eventFilter{}) && v.Before == "" {
				<p class="opacity-70">No events yet.</p>
			} else {
				<p class="opacity-70">No events match.</p>
			}
		</div>
	} else {
		<div class={ web.CardClass, "overflow-hidden" }>
			<div aria-hidden="true" class={ eventColumns, "border-b border-base-300 py-2 text-xs opacity-60 max-sm:hidden" }>
				<span>Time (UTC)</span>
				<span>Event</span>
				<span>Device</span>
				<span>User</span>
				<span>Country</span>
				<span>Version</span>
			</div>
			<ul class="divide-y divide-base-300">
				for _, r := range v.Rows {
					<li>
						@eventListRow(r)
					</li>
				}
			</ul>
		</div>
	}
	if v.Before != "" || v.Older != "" {
		<nav aria-label="Pages" class="mt-4 flex justify-end gap-2">
			if v.Before != "" {
				<a href={ templ.SafeURL(eventsURL(v.App.ID, v.Filter, "")) } class="btn btn-sm">Newest</a>
			}
			if v.Older != "" {
				<a href={ templ.SafeURL(v.Older) } class="btn btn-sm">Older</a>
			}
		</nav>
	}
}

templ filterInput(label, name, value string) {
	@web.Field(label, name, "") {
		<input
			{ web.InputAttrs(name, "")... }
			value={ value }
			autocomplete="off"
			spellcheck="false"
			class={ web.InputClass, "input-sm" }
		/>
	}
}

templ eventListRow(r eventRow) {
	<details class="group">
		<summary class={ eventColumns, "cursor-pointer list-none py-2.5 text-sm hover:bg-base-200 [&::-webkit-details-marker]:hidden" }>
			<time class="text-xs leading-5 whitespace-nowrap tabular-nums opacity-70 max-sm:order-2">{ r.Time }</time>
			<span class={ "truncate font-mono text-xs leading-5 max-sm:order-1", templ.KV("text-error", strings.HasPrefix(r.Name, "error.")) } title={ r.Name }>{ r.Name }</span>
			<span class="truncate font-mono text-xs leading-5 opacity-70 max-sm:order-3 max-sm:col-span-2" title={ r.Device }>{ r.Device }</span>
			<span class="truncate leading-5 max-sm:hidden" title={ r.User }>{ r.User }</span>
			<span class="leading-5 max-sm:hidden">{ r.Country }</span>
			<span class="truncate leading-5 max-sm:hidden" title={ r.Version }>{ r.Version }</span>
			<svg class="mt-1 size-3 opacity-50 transition-transform group-open:rotate-90 max-sm:hidden" viewBox="0 0 12 12" fill="none" aria-hidden="true">
				<path d="M4.5 2.5 8 6 4.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</summary>
		<div class="border-t border-base-300 bg-base-200/50 px-4 py-4">
			<dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
				for _, f := range r.Fields {
					<div class="min-w-0">
						<dt class="text-xs opacity-60">{ f.Label }</dt>
						<dd class="text-sm wrap-break-word">
							if f.Filter != "" {
								<a href={ templ.SafeURL(f.Filter) } class="link link-primary link-hover" title={ "Show only " + f.Value }>{ f.Value }</a>
							} else {
								{ f.Value }
							}
						</dd>
					</div>
				}
			</dl>
			if r.Props != "" {
				<p class="mt-4 text-xs opacity-60">Props</p>
				<pre class="mt-1 overflow-x-auto rounded-field border border-base-300 bg-base-100 p-3 font-mono text-xs">{ r.Props }</pre>
			}
		</div>
	</details>
}
