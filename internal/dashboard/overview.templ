package dashboard

import (
	"time"

	"github.com/riadafridishibly/beacon/internal/db"
	"github.com/riadafridishibly/beacon/internal/web"
)

templ overviewPage(nav *web.Nav, v overviewView) {
	@web.Layout(v.App.Name, nav) {
		@appHeader(v.App, "overview")
		<div id="overview" class="transition-opacity [&.htmx-request]:opacity-60">
			@overviewBody(v)
		</div>
	}
}

// appHeader is the title and page tabs shared by an app's pages.
templ appHeader(app db.App, current string) {
	<nav aria-label="Breadcrumb" class="mb-1 text-sm opacity-70">
		<a href="/" class="link-hover">Apps</a>
	</nav>
	@web.PageHeader(app.Name)
	<nav aria-label="App pages" class="tabs tabs-border -mt-2 mb-6 -ml-3">
		@appTab("Overview", "/apps/"+app.ID, current == "overview")
		@appTab("Events", eventsURL(app.ID, eventFilter{}, ""), current == "events")
		@appTab("Users", subjectsURL(app.ID, userSubject, ""), current == "users")
		@appTab("Devices", subjectsURL(app.ID, deviceSubject, ""), current == "devices")
	</nav>
}

templ appTab(label, href string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		if active {
			aria-current="page"
		}
		class={ "tab", templ.KV("tab-active", active) }
	>{ label }</a>
}

func rangeURL(appID, rng string) string { return "/apps/" + appID + "?range=" + rng }

// overviewBody is the part a range change replaces.
templ overviewBody(v overviewView) {
	<div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2">
		<div class="join">
			for _, rng := range ranges {
				<a
					href={ templ.SafeURL(rangeURL(v.App.ID, rng)) }
					hx-get={ rangeURL(v.App.ID, rng) }
					hx-target="#overview"
					hx-indicator="#overview"
					hx-push-url="true"
					if rng == v.Range {
						aria-current="true"
					}
					class={ "btn btn-sm join-item", templ.KV("btn-primary", rng == v.Range) }
				>{ rng }</a>
			}
		</div>
		<p class="text-sm opacity-60">Daily buckets, UTC</p>
	</div>
	if v.Totals.Events == 0 {
		<div class={ web.PaddedCardClass, "text-center" }>
			<p class="opacity-70">No events in this range.</p>
		</div>
	} else {
		<dl class="mb-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
			@tile("Active devices", v.Totals.Devices)
			@tile("Active users", v.Totals.Users)
			@tile("Opens", v.Totals.Opens)
			@tile("Errors", v.Totals.Errors)
		</dl>
		<div class="grid gap-4 lg:grid-cols-2">
			@chartCard(v.Active)
			@chartCard(v.Usage)
			@chartCard(v.Opens)
			@chartCard(v.Startup)
			@chartCard(v.Errors)
			@topErrors(v.TopErrors, v.Now)
		</div>
		<div class="mt-4 grid gap-4 lg:grid-cols-3">
			for _, b := range v.Breakdown {
				@breakdown(b)
			}
		</div>
	}
}

templ tile(label string, n int64) {
	<div class={ web.CardClass, "px-4 py-4 max-sm:mx-0 max-sm:rounded-box max-sm:border-x" }>
		<dt class="text-sm opacity-60">{ label }</dt>
		<dd class="mt-1 text-2xl font-semibold">{ web.Count(n) }</dd>
	</div>
}

templ topErrors(rows []db.OverviewTopErrorsRow, now time.Time) {
	<section class={ web.PaddedCardClass, "min-w-0" }>
		<h2 class="font-semibold">Top errors</h2>
		if len(rows) == 0 {
			<p class="mt-4 text-sm opacity-60">No errors in this range.</p>
		} else {
			<div class="mt-3 overflow-x-auto">
				<table class="table table-sm">
					<thead>
						<tr>
							<th scope="col">Error</th>
							<th scope="col" class="text-right">Devices</th>
							<th scope="col" class="text-right">Users</th>
							<th scope="col" class="text-right">Last seen</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range rows {
							<tr>
								<td class="max-w-64">
									<p class="font-mono text-xs">{ e.Name }</p>
									if e.Message != "" {
										<p class="line-clamp-2 wrap-break-word opacity-70" title={ e.Message }>{ e.Message }</p>
									}
								</td>
								<td class="text-right tabular-nums">{ web.Count(e.Devices) }</td>
								<td class="text-right tabular-nums">{ web.Count(e.Users) }</td>
								<td class="text-right whitespace-nowrap">
									<time datetime={ e.LastSeen.UTC().Format(time.RFC3339) } title={ e.LastSeen.UTC().Format("2006-01-02 15:04 UTC") }>{ ago(e.LastSeen, now) }</time>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ breakdown(b breakdownView) {
	<section class={ web.PaddedCardClass, "min-w-0" }>
		<h2 class="font-semibold">{ b.Title }</h2>
		<p class="text-sm opacity-60">Active devices</p>
		<ul class="mt-3 space-y-3">
			for _, r := range b.Rows {
				<li>
					<div class="mb-1 flex justify-between gap-3 text-sm">
						if r.Label == "" {
							<span class="opacity-60">Unknown</span>
						} else {
							<span class="min-w-0 wrap-break-word">{ r.Label }</span>
						}
						<span class="tabular-nums">{ web.Count(r.Devices) }</span>
					</div>
					<svg class="h-2 w-full" aria-hidden="true">
						<rect width={ barWidthPct(r.Devices, b.Top) } height="8" rx="4" class="fill-chart-1"></rect>
					</svg>
				</li>
			}
		</ul>
	</section>
}
