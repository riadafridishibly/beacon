package dashboard

import (
	"slices"
	"strconv"

	"github.com/riadafridishibly/beacon/internal/db"
	"github.com/riadafridishibly/beacon/internal/web"
)

templ viewsPage(nav *web.Nav, app db.App, views []db.AppView) {
	@web.Layout("Views · "+app.Name, nav) {
		@appHeader(app, "views")
		<div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
			<p class="text-sm opacity-70">Charts of this app's own events. The overview shows them in this order.</p>
			if len(views) < maxViews {
				<a href={ templ.SafeURL(viewsURL(app.ID) + "/new") } class={ web.ButtonClass, "btn-sm" }>New view</a>
			}
		</div>
		if len(views) == 0 {
			<div class={ web.PaddedCardClass, "text-center" }>
				<p class="opacity-70">No views yet.</p>
			</div>
		} else {
			<ul class={ web.CardClass, "divide-y divide-base-300" }>
				for _, v := range views {
					<li class="flex items-center justify-between gap-4 px-4 py-3">
						<div class="min-w-0">
							<p class="font-medium wrap-break-word">{ v.Title }</p>
							<p class="font-mono text-xs wrap-anywhere opacity-60">{ describeView(v) }</p>
						</div>
						<div class="flex shrink-0 gap-2">
							<a href={ templ.SafeURL(viewURL(app.ID, v.ID)) } class="btn btn-sm">Edit</a>
							<form
								method="post"
								action={ templ.SafeURL(viewURL(app.ID, v.ID) + "/delete") }
								hx-boost="true"
								hx-confirm={ "Delete the view " + v.Title + "?" }
							>
								<button type="submit" class="btn btn-sm btn-error btn-soft">Delete</button>
							</form>
						</div>
					</li>
				}
			</ul>
		}
	}
}

templ viewFormPage(nav *web.Nav, app db.App, f viewForm) {
	@web.Layout(viewFormTitle(f)+" · "+app.Name, nav) {
		@appHeader(app, "views")
		<form method="post" action={ templ.SafeURL(f.action(app.ID)) } class={ web.PaddedCardClass, "max-w-2xl space-y-5" }>
			<h2 class="text-lg font-semibold">{ viewFormTitle(f) }</h2>
			if f.FormError != "" {
				<p role="alert" class="alert alert-error alert-soft"><span>{ f.FormError }</span></p>
			}
			@web.Field("Title", "title", f.TitleError) {
				<input
					type="text"
					{ web.InputAttrs("title", f.TitleError)... }
					value={ f.Title }
					required
					maxlength="100"
					autocomplete="off"
					class={ web.InputClass }
				/>
			}
			@web.Field("Event", "event", f.EventError) {
				<input
					type="text"
					{ web.InputAttrs("event", f.EventError)... }
					value={ f.Event }
					required
					maxlength="64"
					list="view-events"
					autocomplete="off"
					spellcheck="false"
					class={ web.InputClass, "font-mono" }
				/>
				<datalist id="view-events">
					for _, e := range f.Events {
						<option value={ e }></option>
					}
				</datalist>
			}
			<fieldset
				class="space-y-1.5"
				if f.MeasureError != "" {
					aria-describedby="measure-error"
				}
			>
				<legend class="mb-1.5 text-sm font-medium">Measures</legend>
				<div class="flex flex-wrap gap-x-5 gap-y-2">
					for _, id := range measureIDs {
						<label class="flex items-center gap-2 text-sm">
							<input
								type="checkbox"
								name="measure"
								value={ id }
								checked?={ slices.Contains(f.Measures, id) }
								class="checkbox checkbox-sm"
							/>
							{ describeMeasures([]string{ id }) }
						</label>
					}
				</div>
				<p class="text-sm opacity-60">Events and devices can share a chart, and so can p50 and p95. The sum goes alone. A table sorts by the first one listed.</p>
				if f.MeasureError != "" {
					<p id="measure-error" class="text-sm text-error">{ f.MeasureError }</p>
				}
			</fieldset>
			@web.Field("Group by", "group_by", f.GroupByError) {
				<input
					type="text"
					{ web.InputAttrs("group_by", f.GroupByError)... }
					value={ f.GroupBy }
					maxlength="106"
					list="view-fields"
					autocomplete="off"
					spellcheck="false"
					class={ web.InputClass, "font-mono" }
				/>
				<datalist id="view-fields">
					for _, field := range f.Fields {
						<option value={ field }></option>
					}
				</datalist>
				<p class="text-sm opacity-60">A column (platform, app_version, country) or props.&lt;key&gt;. Leave it empty for a chart by day.</p>
			}
			@web.Field("Show groups as", "shape", f.ShapeError) {
				<select { web.InputAttrs("shape", f.ShapeError)... } class="select w-full">
					for _, s := range shapes {
						<option value={ s.ID } selected?={ s.ID == f.Shape }>{ s.Label }</option>
					}
				</select>
				<p class="text-sm opacity-60">A table of the top { strconv.Itoa(viewGroupLimit) } groups by count, or a line for each of the top { strconv.Itoa(viewLineLimit) } and one for the rest. Without a group by, it's a chart by day.</p>
			}
			@web.Field("Filter", "filter", f.FilterError) {
				<textarea
					{ web.InputAttrs("filter", f.FilterError)... }
					rows="3"
					maxlength="2000"
					spellcheck="false"
					placeholder={ `{"props.result": "ok", "platform": "macos"}` }
					class="textarea w-full font-mono aria-[invalid=true]:textarea-error"
				>{ f.Filter }</textarea>
				<p class="text-sm opacity-60">A JSON object whose keys use the same names as group by. Every key must match. Props compare with their JSON type, so true and "true" differ.</p>
			}
			<div class="flex justify-end gap-2">
				<a href={ templ.SafeURL(viewsURL(app.ID)) } class="btn btn-ghost">Cancel</a>
				<button type="submit" class={ web.ButtonClass }>Save view</button>
			</div>
		</form>
	}
}

func viewFormTitle(f viewForm) string {
	if f.ID == 0 {
		return "New view"
	}
	return "Edit view"
}

templ viewCardSection(c viewCard) {
	if c.Failed {
		<section class={ web.PaddedCardClass, "min-w-0" }>
			<h2 class="font-semibold wrap-break-word">{ c.Title }</h2>
			<p class="text-sm wrap-anywhere opacity-60">{ c.Summary }</p>
			<p class="mt-4 text-sm text-error">This view couldn't be loaded. The server log has the reason.</p>
		</section>
	} else if c.Groups == nil {
		@chartCard(c.Chart)
	} else {
		<section class={ web.PaddedCardClass, "min-w-0" }>
			<h2 class="font-semibold wrap-break-word">{ c.Title }</h2>
			<p class="text-sm wrap-anywhere opacity-60">{ c.Summary }</p>
			if len(c.Groups.Rows) == 0 {
				<p class="mt-4 text-sm opacity-60">No matching events in this range.</p>
			} else {
				@viewTable(c.Groups)
			}
		</section>
	}
}

templ viewTable(g *viewGroups) {
	<div class="mt-3 overflow-x-auto">
		<table class="table table-sm">
			<thead>
				<tr>
					<th scope="col" class="font-mono">{ g.Field }</th>
					@viewHeader("Events", g.sortedBy("count"))
					if g.shows("distinct_devices") {
						@viewHeader("Devices", g.sortedBy("distinct_devices"))
					}
					if g.shows("sum") {
						@viewHeader("Sum", true)
					}
					if g.Values {
						@viewHeader("p50", g.sortedBy("p50"))
						@viewHeader("p95", g.sortedBy("p95"))
					}
				</tr>
			</thead>
			<tbody>
				for _, r := range g.Rows {
					<tr>
						<td class="max-w-64">
							if r.Label == "" {
								<span class="italic opacity-60">Unknown</span>
							} else {
								<span class="line-clamp-2 wrap-anywhere" title={ r.Label }>{ r.Label }</span>
							}
						</td>
						<td class="text-right tabular-nums">{ web.Count(r.Events) }</td>
						if g.shows("distinct_devices") {
							<td class="text-right tabular-nums">{ web.Count(r.Devices) }</td>
						}
						if g.shows("sum") {
							<td class="text-right tabular-nums">{ measureText(r.WithValue, r.Total) }</td>
						}
						if g.Values {
							<td class="text-right tabular-nums" title={ withValueTitle(r) }>{ measureText(r.WithValue, r.P50) }</td>
							<td class="text-right tabular-nums" title={ withValueTitle(r) }>{ measureText(r.WithValue, r.P95) }</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ viewHeader(label string, sorted bool) {
	<th
		scope="col"
		if sorted {
			aria-sort="descending"
		}
		class={ "text-right", templ.KV("text-base-content", sorted) }
	>{ label }</th>
}

func measureText(withValue int64, v float64) string {
	if withValue == 0 {
		return "–"
	}
	return valueText(v)
}

func withValueTitle(r db.ViewGroupsRow) string {
	if r.WithValue == r.Events {
		return ""
	}
	return "From the " + web.Count(r.WithValue) + " events with a value"
}
